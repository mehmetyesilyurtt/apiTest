@page "/"
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<div style="background-color: #121212; color: #e0e0e0; min-height: 100vh; padding: 40px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <h1 style="color: #4facfe; margin-bottom: 30px; font-weight: 300;">API Analyzer <span style="font-weight: 700;">Live</span></h1>

    <div style="background: #1e1e1e; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); margin-bottom: 30px;">
        <!-- URL ve Method Bölümü -->
        <div style="display: flex; gap: 15px; margin-bottom: 15px;">
            <select @bind="method" style="background: #2d2d2d; color: white; border: 1px solid #444; padding: 12px; border-radius: 8px; cursor: pointer; outline: none;">
                <option value="GET">GET</option>
                <option value="POST">POST</option>
                <option value="PUT">PUT</option>
                <option value="DELETE">DELETE</option>
            </select>

            <input @bind="url" placeholder="https://api.test.com/endpoint" style="flex: 1; background: #2d2d2d; color: white; border: 1px solid #444; padding: 12px; border-radius: 8px; outline: none;" />

            <button @onclick="AnalyzeApi" disabled="@isLoading" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: #fff; padding: 12px 30px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; transition: transform 0.2s; opacity: @(isLoading ? "0.6" : "1");">
                @if (isLoading)
                {
                    <span>ANALİZ EDİLİYOR...</span>
                }
                else
                {
                    <span>ANALİZ ET</span>
                }
            </button>
        </div>

        <!-- Headers Bölümü -->
        <div style="margin-bottom: 15px;">
            <button @onclick="ToggleHeaders" style="background: #2d2d2d; color: #aaa; border: 1px solid #444; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; margin-bottom: 10px;">
                🔧 HEADERS @(showHeaders ? "▼" : "▶")
            </button>

            @if (showHeaders)
            {
                <div style="background: #0d0d0d; padding: 15px; border-radius: 8px; border: 1px solid #333;">
                    @foreach (var header in headers)
                    {
                        <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                            <input @bind="header.Key" placeholder="Header Key" style="flex: 1; background: #2d2d2d; color: white; border: 1px solid #444; padding: 8px; border-radius: 6px; outline: none; font-size: 12px;" />
                            <input @bind="header.Value" placeholder="Header Value" style="flex: 1; background: #2d2d2d; color: white; border: 1px solid #444; padding: 8px; border-radius: 6px; outline: none; font-size: 12px;" />
                            <button @onclick="() => RemoveHeader(header)" style="background: #d32f2f; color: white; border: none; padding: 8px 12px; border-radius: 6px; cursor: pointer; font-size: 12px;">❌</button>
                        </div>
                    }
                    <button @onclick="AddHeader" style="background: #4facfe; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; margin-top: 5px;">+ Header Ekle</button>
                </div>
            }
        </div>

        <!-- Request Body Bölümü (POST/PUT için) -->
        @if (method == "POST" || method == "PUT")
        {
            <div style="margin-top: 15px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <label style="color: #aaa; font-size: 12px; font-weight: bold;">📝 REQUEST BODY</label>
                    <div style="display: flex; gap: 10px;">
                        <button @onclick="FormatRequestBody" style="background: #4facfe; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 11px;">
                            ✨ Format JSON
                        </button>
                        <select @bind="contentType" style="background: #2d2d2d; color: white; border: 1px solid #444; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 11px;">
                            <option value="application/json">JSON</option>
                            <option value="application/xml">XML</option>
                            <option value="text/plain">Text</option>
                            <option value="application/x-www-form-urlencoded">Form URL Encoded</option>
                        </select>
                    </div>
                </div>
                <textarea @bind="requestBody"
                          placeholder='{"name": "John", "age": 30}'
                          style="width: 100%; min-height: 150px; background: #0d0d0d; color: #b2ff59; border: 1px solid #333; padding: 15px; border-radius: 8px; font-family: 'Consolas', monospace; font-size: 13px; outline: none; resize: vertical;"></textarea>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background: #d32f2f; color: white; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
            ❌ @errorMessage
        </div>
    }

    @if (response != null)
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px;">
            <div style="background: #1e1e1e; padding: 20px; border-radius: 12px; border-left: 4px solid #4facfe;">
                <div style="font-size: 12px; color: #888; text-transform: uppercase;">Durum</div>
                <div style="font-size: 28px; font-weight: bold; color: @(response.StatusCode < 400 ? "#00c853" : "#ff1744")">
                    @response.StatusCode
                </div>
            </div>
            <div style="background: #1e1e1e; padding: 20px; border-radius: 12px; border-left: 4px solid #fbc02d;">
                <div style="font-size: 12px; color: #888; text-transform: uppercase;">Zaman</div>
                <div style="font-size: 28px; font-weight: bold; color: #fbc02d;">
                    @response.ElapsedMs.ToString("F0") <span style="font-size: 16px;">ms</span>
                </div>
            </div>
            <div style="background: #1e1e1e; padding: 20px; border-radius: 12px; border-left: 4px solid #ea80fc;">
                <div style="font-size: 12px; color: #888; text-transform: uppercase;">Boyut</div>
                <div style="font-size: 28px; font-weight: bold; color: #ea80fc;">
                    @response.ContentLength <span style="font-size: 16px;">bytes</span>
                </div>
            </div>
        </div>

        <!-- Response Body -->
        <div style="background: #1e1e1e; border-radius: 12px; overflow: hidden; border: 1px solid #333; margin-bottom: 30px;">
            <div style="background: #2d2d2d; padding: 10px 20px; font-size: 13px; color: #aaa; border-bottom: 1px solid #333; display: flex; justify-content: space-between; align-items: center;">
                <span>RESPONSE BODY</span>
                <button @onclick="CopyToClipboard" style="background: #4facfe; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 12px;">
                    📋 KOPYALA
                </button>
            </div>
            <pre style="margin: 0; padding: 20px; color: #e0e0e0; font-family: 'Consolas', 'Monaco', monospace; overflow-x: auto; font-size: 14px; line-height: 1.6; max-height: 600px; overflow-y: auto;">@((MarkupString)formattedContent)</pre>
        </div>

        <!-- Model Generator -->
        @if (!string.IsNullOrEmpty(response.Content))
        {
            <div style="background: #1e1e1e; border-radius: 12px; overflow: hidden; border: 1px solid #333;">
                <div style="background: #2d2d2d; padding: 15px 20px; border-bottom: 1px solid #333;">
                    <div style="font-size: 13px; color: #aaa; margin-bottom: 15px;">🎯 MODEL GENERATOR</div>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <button @onclick="GenerateCSharp"
                                style="background: @(selectedLanguage == "csharp" ? "#239120" : "#2d2d2d"); color: white; border: 1px solid @(selectedLanguage == "csharp" ? "#239120" : "#444"); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all 0.2s;">
                            C#
                        </button>
                        <button @onclick="GenerateJava"
                                style="background: @(selectedLanguage == "java" ? "#007396" : "#2d2d2d"); color: white; border: 1px solid @(selectedLanguage == "java" ? "#007396" : "#444"); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all 0.2s;">
                            Java
                        </button>
                        <button @onclick="GeneratePython"
                                style="background: @(selectedLanguage == "python" ? "#3776AB" : "#2d2d2d"); color: white; border: 1px solid @(selectedLanguage == "python" ? "#3776AB" : "#444"); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all 0.2s;">
                            Python
                        </button>
                        <button @onclick="GenerateTypeScript"
                                style="background: @(selectedLanguage == "typescript" ? "#3178C6" : "#2d2d2d"); color: white; border: 1px solid @(selectedLanguage == "typescript" ? "#3178C6" : "#444"); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all 0.2s;">
                            TypeScript
                        </button>
                        <button @onclick="GenerateJavaScript"
                                style="background: @(selectedLanguage == "javascript" ? "#F7DF1E" : "#2d2d2d"); color: @(selectedLanguage == "javascript" ? "#000" : "white"); border: 1px solid @(selectedLanguage == "javascript" ? "#F7DF1E" : "#444"); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all 0.2s;">
                            JavaScript
                        </button>
                        <button @onclick="GenerateGo"
                                style="background: @(selectedLanguage == "go" ? "#00ADD8" : "#2d2d2d"); color: white; border: 1px solid @(selectedLanguage == "go" ? "#00ADD8" : "#444"); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all 0.2s;">
                            Go
                        </button>
                        <button @onclick="GeneratePHP"
                                style="background: @(selectedLanguage == "php" ? "#777BB4" : "#2d2d2d"); color: white; border: 1px solid @(selectedLanguage == "php" ? "#777BB4" : "#444"); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all 0.2s;">
                            PHP
                        </button>
                        <button @onclick="GenerateKotlin"
                                style="background: @(selectedLanguage == "kotlin" ? "#7F52FF" : "#2d2d2d"); color: white; border: 1px solid @(selectedLanguage == "kotlin" ? "#7F52FF" : "#444"); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all 0.2s;">
                            Kotlin
                        </button>
                        <button @onclick="GenerateSwift"
                                style="background: @(selectedLanguage == "swift" ? "#FA7343" : "#2d2d2d"); color: white; border: 1px solid @(selectedLanguage == "swift" ? "#FA7343" : "#444"); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all 0.2s;">
                            Swift
                        </button>
                        <button @onclick="GenerateRust"
                                style="background: @(selectedLanguage == "rust" ? "#CE422B" : "#2d2d2d"); color: white; border: 1px solid @(selectedLanguage == "rust" ? "#CE422B" : "#444"); padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all 0.2s;">
                            Rust
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(generatedModel))
                {
                    <div style="position: relative;">
                        <button @onclick="CopyModelToClipboard"
                                style="position: absolute; top: 15px; right: 15px; background: #4facfe; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; z-index: 10;">
                            📋 KOPYALA
                        </button>
                        <pre style="margin: 0; padding: 20px; padding-top: 50px; color: #e0e0e0; font-family: 'Consolas', 'Monaco', monospace; overflow-x: auto; font-size: 13px; line-height: 1.6; max-height: 500px; overflow-y: auto; background: #1a1a1a;">@generatedModel</pre>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private string url = "https://jsonplaceholder.typicode.com/posts";
    private string method = "GET";
    private bool isLoading = false;
    private string errorMessage = "";
    private ApiResponse? response;
    private string formattedContent = "";
    private string generatedModel = "";
    private string selectedLanguage = "";

    // Yeni özellikler
    private string requestBody = "";
    private string contentType = "application/json";
    private bool showHeaders = false;
    private List<HeaderItem> headers = new List<HeaderItem>();

    private class HeaderItem
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private class ApiResponse
    {
        public int StatusCode { get; set; }
        public double ElapsedMs { get; set; }
        public long ContentLength { get; set; }
        public string Content { get; set; } = "";
    }

    protected override void OnInitialized()
    {
        // Varsayılan header
        headers.Add(new HeaderItem { Key = "Content-Type", Value = "application/json" });
    }

    private void ToggleHeaders()
    {
        showHeaders = !showHeaders;
    }

    private void AddHeader()
    {
        headers.Add(new HeaderItem());
    }

    private void RemoveHeader(HeaderItem header)
    {
        headers.Remove(header);
    }

    private void FormatRequestBody()
    {
        try
        {
            var jsonDoc = JsonDocument.Parse(requestBody);
            requestBody = JsonSerializer.Serialize(jsonDoc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            // JSON değilse hiçbir şey yapma
        }
    }

    private async Task AnalyzeApi()
    {
        isLoading = true;
        errorMessage = "";
        response = null;
        formattedContent = "";
        generatedModel = "";
        selectedLanguage = "";

        try
        {
            var req = new
            {
                Method = method,
                Url = url,
                Body = (method == "POST" || method == "PUT") ? requestBody : null,
                Headers = headers.Where(h => !string.IsNullOrWhiteSpace(h.Key))
                                 .ToDictionary(h => h.Key, h => h.Value),
                ContentType = contentType
            };

            var res = await Http.PostAsJsonAsync("https://localhost:44319/api/Analyze", req);

            if (res.IsSuccessStatusCode)
            {
                response = await res.Content.ReadFromJsonAsync<ApiResponse>();

                if (response != null)
                {
                    formattedContent = FormatJson(response.Content);
                }
            }
            else
            {
                errorMessage = $"Backend hatası: {res.StatusCode}";
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Bağlantı hatası: {ex.Message}. Backend çalışıyor mu?";
        }
        catch (Exception ex)
        {
            errorMessage = $"Hata: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Ayrı metotlar her dil için
    private void GenerateCSharp() => GenerateModel("csharp");
    private void GenerateJava() => GenerateModel("java");
    private void GeneratePython() => GenerateModel("python");
    private void GenerateTypeScript() => GenerateModel("typescript");
    private void GenerateJavaScript() => GenerateModel("javascript");
    private void GenerateGo() => GenerateModel("go");
    private void GeneratePHP() => GenerateModel("php");
    private void GenerateKotlin() => GenerateModel("kotlin");
    private void GenerateSwift() => GenerateModel("swift");
    private void GenerateRust() => GenerateModel("rust");

    private string FormatJson(string json)
    {
        try
        {
            var jsonDocument = JsonDocument.Parse(json);
            var formatted = JsonSerializer.Serialize(
                jsonDocument.RootElement,
                new JsonSerializerOptions { WriteIndented = true }
            );
            return ApplySyntaxHighlighting(formatted);
        }
        catch
        {
            return System.Web.HttpUtility.HtmlEncode(json);
        }
    }

    private string ApplySyntaxHighlighting(string json)
    {
        json = System.Web.HttpUtility.HtmlEncode(json);
        json = System.Text.RegularExpressions.Regex.Replace(json, @"&quot;([^&]*)&quot;(\s*:\s*&quot;)", "<span style='color: #9cdcfe;'>&quot;$1&quot;</span>$2");
        json = System.Text.RegularExpressions.Regex.Replace(json, @":\s*&quot;([^&]*)&quot;", ": <span style='color: #ce9178;'>&quot;$1&quot;</span>");
        json = System.Text.RegularExpressions.Regex.Replace(json, @":\s*(\d+\.?\d*)", ": <span style='color: #b5cea8;'>$1</span>");
        json = System.Text.RegularExpressions.Regex.Replace(json, @":\s*(true|false|null)", ": <span style='color: #569cd6;'>$1</span>");
        return json;
    }

    private void GenerateModel(string language)
    {
        selectedLanguage = language;

        if (response == null || string.IsNullOrEmpty(response.Content))
        {
            generatedModel = "// Hata: JSON verisi bulunamadı";
            return;
        }

        try
        {
            var jsonDoc = JsonDocument.Parse(response.Content);
            var root = jsonDoc.RootElement;

            generatedModel = language switch
            {
                "csharp" => GenerateCSharpModel(root),
                "java" => GenerateJavaModel(root),
                "python" => GeneratePythonModel(root),
                "typescript" => GenerateTypeScriptModel(root),
                "javascript" => GenerateJavaScriptModel(root),
                "go" => GenerateGoModel(root),
                "php" => GeneratePHPModel(root),
                "kotlin" => GenerateKotlinModel(root),
                "swift" => GenerateSwiftModel(root),
                "rust" => GenerateRustModel(root),
                _ => "// Desteklenmeyen dil"
            };
        }
        catch (Exception ex)
        {
            generatedModel = $"// Model oluşturma hatası: {ex.Message}";
        }
    }

    // Tüm model generator metodları aynı kalıyor...
    // (Önceki koddan kopyalayın: GenerateCSharpModel, GenerateJavaModel, vs.)

    private string GenerateCSharpModel(JsonElement root)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("using System;");
        sb.AppendLine("using System.Collections.Generic;");
        sb.AppendLine("using System.Text.Json.Serialization;");
        sb.AppendLine();

        if (root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0)
        {
            sb.AppendLine("public class ApiResponse");
            sb.AppendLine("{");
            GenerateCSharpProperties(root[0], sb, 1);
            sb.AppendLine("}");
        }
        else if (root.ValueKind == JsonValueKind.Object)
        {
            sb.AppendLine("public class ApiResponse");
            sb.AppendLine("{");
            GenerateCSharpProperties(root, sb, 1);
            sb.AppendLine("}");
        }

        return sb.ToString();
    }

    private void GenerateCSharpProperties(JsonElement element, System.Text.StringBuilder sb, int indent)
    {
        var indentStr = new string(' ', indent * 4);

        foreach (var property in element.EnumerateObject())
        {
            var propName = ToPascalCase(property.Name);
            var csharpType = GetCSharpType(property.Value);

            sb.AppendLine($"{indentStr}public {csharpType} {propName} {{ get; set; }}");
            sb.AppendLine();
        }
    }

    private string GetCSharpType(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.String => "string",
            JsonValueKind.Number => element.TryGetInt32(out _) ? "int" : "double",
            JsonValueKind.True or JsonValueKind.False => "bool",
            JsonValueKind.Array => "List<object>",
            JsonValueKind.Object => "object",
            JsonValueKind.Null => "object",
            _ => "object"
        };
    }

    private string GenerateJavaModel(JsonElement root)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("import com.fasterxml.jackson.annotation.JsonProperty;");
        sb.AppendLine("import java.util.List;");
        sb.AppendLine();
        sb.AppendLine("public class ApiResponse {");
        sb.AppendLine();

        var element = root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0 ? root[0] : root;

        foreach (var property in element.EnumerateObject())
        {
            var propName = ToCamelCase(property.Name);
            var javaType = GetJavaType(property.Value);

            sb.AppendLine($"    @JsonProperty(\"{property.Name}\")");
            sb.AppendLine($"    private {javaType} {propName};");
            sb.AppendLine();
        }

        sb.AppendLine("    // Getters and Setters");
        sb.AppendLine("}");

        return sb.ToString();
    }

    private string GetJavaType(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.String => "String",
            JsonValueKind.Number => element.TryGetInt32(out _) ? "Integer" : "Double",
            JsonValueKind.True or JsonValueKind.False => "Boolean",
            JsonValueKind.Array => "List<Object>",
            JsonValueKind.Object => "Object",
            _ => "Object"
        };
    }

    private string GeneratePythonModel(JsonElement root)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("from dataclasses import dataclass");
        sb.AppendLine("from typing import Optional, List, Any");
        sb.AppendLine();
        sb.AppendLine("@dataclass");
        sb.AppendLine("class ApiResponse:");

        var element = root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0 ? root[0] : root;

        foreach (var property in element.EnumerateObject())
        {
            var propName = ToSnakeCase(property.Name);
            var pythonType = GetPythonType(property.Value);
            sb.AppendLine($"    {propName}: {pythonType}");
        }

        return sb.ToString();
    }

    private string GetPythonType(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.String => "str",
            JsonValueKind.Number => element.TryGetInt32(out _) ? "int" : "float",
            JsonValueKind.True or JsonValueKind.False => "bool",
            JsonValueKind.Array => "List[Any]",
            JsonValueKind.Object => "dict",
            JsonValueKind.Null => "Optional[Any]",
            _ => "Any"
        };
    }

    private string GenerateTypeScriptModel(JsonElement root)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("export interface ApiResponse {");

        var element = root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0 ? root[0] : root;

        foreach (var property in element.EnumerateObject())
        {
            var tsType = GetTypeScriptType(property.Value);
            sb.AppendLine($"  {property.Name}: {tsType};");
        }

        sb.AppendLine("}");
        return sb.ToString();
    }

    private string GetTypeScriptType(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.String => "string",
            JsonValueKind.Number => "number",
            JsonValueKind.True or JsonValueKind.False => "boolean",
            JsonValueKind.Array => "any[]",
            JsonValueKind.Object => "object",
            JsonValueKind.Null => "null",
            _ => "any"
        };
    }

    private string GenerateJavaScriptModel(JsonElement root)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("class ApiResponse {");
        sb.AppendLine("  constructor(data) {");

        var element = root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0 ? root[0] : root;

        foreach (var property in element.EnumerateObject())
        {
            sb.AppendLine($"    this.{property.Name} = data.{property.Name};");
        }

        sb.AppendLine("  }");
        sb.AppendLine("}");
        return sb.ToString();
    }

    private string GenerateGoModel(JsonElement root)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("type ApiResponse struct {");

        var element = root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0 ? root[0] : root;

        foreach (var property in element.EnumerateObject())
        {
            var propName = ToPascalCase(property.Name);
            var goType = GetGoType(property.Value);
            sb.AppendLine($"    {propName} {goType} `json:\"{property.Name}\"`");
        }

        sb.AppendLine("}");
        return sb.ToString();
    }

    private string GetGoType(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.String => "string",
            JsonValueKind.Number => element.TryGetInt32(out _) ? "int" : "float64",
            JsonValueKind.True or JsonValueKind.False => "bool",
            JsonValueKind.Array => "[]interface{}",
            JsonValueKind.Object => "map[string]interface{}",
            _ => "interface{}"
        };
    }

    private string GeneratePHPModel(JsonElement root)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("<?php");
        sb.AppendLine();
        sb.AppendLine("class ApiResponse {");

        var element = root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0 ? root[0] : root;

        foreach (var property in element.EnumerateObject())
        {
            sb.AppendLine($"    public ${property.Name};");
        }

        sb.AppendLine();
        sb.AppendLine("    public function __construct($data) {");
        foreach (var property in element.EnumerateObject())
        {
            sb.AppendLine($"        $this->{property.Name} = $data['{property.Name}'] ?? null;");
        }
        sb.AppendLine("    }");
        sb.AppendLine("}");

        return sb.ToString();
    }

    private string GenerateKotlinModel(JsonElement root)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("import com.google.gson.annotations.SerializedName");
        sb.AppendLine();
        sb.Append("data class ApiResponse(");

        var element = root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0 ? root[0] : root;
        var properties = element.EnumerateObject().ToList();

        for (int i = 0; i < properties.Count; i++)
        {
            var property = properties[i];
            var kotlinType = GetKotlinType(property.Value);
            sb.AppendLine();
            sb.Append($"    @SerializedName(\"{property.Name}\")");
            sb.AppendLine();
            sb.Append($"    val {ToCamelCase(property.Name)}: {kotlinType}");
            if (i < properties.Count - 1) sb.Append(",");
        }

        sb.AppendLine();
        sb.AppendLine(")");

        return sb.ToString();
    }

    private string GetKotlinType(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.String => "String",
            JsonValueKind.Number => element.TryGetInt32(out _) ? "Int" : "Double",
            JsonValueKind.True or JsonValueKind.False => "Boolean",
            JsonValueKind.Array => "List<Any>",
            JsonValueKind.Object => "Any",
            _ => "Any?"
        };
    }

    private string GenerateSwiftModel(JsonElement root)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("struct ApiResponse: Codable {");

        var element = root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0 ? root[0] : root;

        foreach (var property in element.EnumerateObject())
        {
            var swiftType = GetSwiftType(property.Value);
            sb.AppendLine($"    let {ToCamelCase(property.Name)}: {swiftType}");
        }

        sb.AppendLine();
        sb.AppendLine("    enum CodingKeys: String, CodingKey {");
        foreach (var property in element.EnumerateObject())
        {
            sb.AppendLine($"        case {ToCamelCase(property.Name)} = \"{property.Name}\"");
        }
        sb.AppendLine("    }");
        sb.AppendLine("}");

        return sb.ToString();
    }

    private string GetSwiftType(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.String => "String",
            JsonValueKind.Number => element.TryGetInt32(out _) ? "Int" : "Double",
            JsonValueKind.True or JsonValueKind.False => "Bool",
            JsonValueKind.Array => "[Any]",
            JsonValueKind.Object => "[String: Any]",
            _ => "Any?"
        };
    }

    private string GenerateRustModel(JsonElement root)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("use serde::{Deserialize, Serialize};");
        sb.AppendLine();
        sb.AppendLine("#[derive(Debug, Serialize, Deserialize)]");
        sb.AppendLine("pub struct ApiResponse {");

        var element = root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0 ? root[0] : root;

        foreach (var property in element.EnumerateObject())
        {
            var rustType = GetRustType(property.Value);
            sb.AppendLine($"    pub {ToSnakeCase(property.Name)}: {rustType},");
        }

        sb.AppendLine("}");
        return sb.ToString();
    }

    private string GetRustType(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.String => "String",
            JsonValueKind.Number => element.TryGetInt32(out _) ? "i32" : "f64",
            JsonValueKind.True or JsonValueKind.False => "bool",
            JsonValueKind.Array => "Vec<serde_json::Value>",
            JsonValueKind.Object => "serde_json::Value",
            _ => "Option<serde_json::Value>"
        };
    }

    // Helper methods
    private string ToPascalCase(string str)
    {
        if (string.IsNullOrEmpty(str)) return str;
        var words = str.Split(new[] { '_', '-', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        return string.Join("", words.Select(w => char.ToUpper(w[0]) + w.Substring(1).ToLower()));
    }

    private string ToCamelCase(string str)
    {
        var pascal = ToPascalCase(str);
        return string.IsNullOrEmpty(pascal) ? pascal : char.ToLower(pascal[0]) + pascal.Substring(1);
    }

    private string ToSnakeCase(string str)
    {
        if (string.IsNullOrEmpty(str)) return str;
        return string.Concat(str.Select((x, i) => i > 0 && char.IsUpper(x) ? "_" + x.ToString() : x.ToString())).ToLower();
    }

    private async Task CopyToClipboard()
    {
        if (response != null)
        {
            try
            {
                var jsonDoc = JsonDocument.Parse(response.Content);
                var formatted = JsonSerializer.Serialize(jsonDoc.RootElement, new JsonSerializerOptions { WriteIndented = true });
                await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", formatted);
            }
            catch
            {
                await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", response.Content);
            }
        }
    }

    private async Task CopyModelToClipboard()
    {
        if (!string.IsNullOrEmpty(generatedModel))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", generatedModel);
        }
    }
}